{
  "name": "dsh-progress-observer",
  "version": "0.2.1",
  "description": "Ask a second model what a running DeepSeek Harness task is doing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmj94/dsh-task-progress.git"
  },
  "homepage": "https://github.com/nmj94/dsh-task-progress#readme",
  "bugs": "https://github.com/nmj94/dsh-task-progress/issues",
  "keywords": ["dsh-plugin", "deepseek-harness", "task-progress"],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "files": [
    "client.js",
    "index.js",
    "progress.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test"
  }
}
